---
import type { CollectionEntry } from "astro:content"
interface Props { product: CollectionEntry<"products">; eager?: boolean }
const { product, eager = false } = Astro.props
const { title, price, image, imageAlt, accent } = product.data
---
<a class="card" href={`/produits/${product.id}/`} style={`--accent: var(--${accent})`}>
  <div class="shot"><img src={image} alt={imageAlt || title} width="900" height="1125" loading={eager ? "eager" : "lazy"} decoding="async" /></div>
  <div class="meta">
    <h3>{title}</h3>
    <span class="price">{price} $</span>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; }
  .shot { aspect-ratio: 4 / 5; background: var(--white); border: 1px solid var(--gray-200); border-radius: 18px; overflow: hidden; transition: border-color 160ms ease; }
  .shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 320ms ease; }
  @media (hover: hover) {
    .card:hover .shot { border-color: var(--accent); }
    .card:hover .shot img { transform: scale(1.03); }
  }
  .card:active .shot { opacity: 0.85; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.75rem 0.25rem 0; }
  h3 { font-size: 1rem; font-weight: 600; }
  .price { font-family: var(--font-display); font-weight: 600; font-size: 0.9375rem; padding: 0.125rem 0.625rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 22%, var(--white)); }
</style>
