---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import { formatPrice, statusLabel } from "../nav"
// clone: a copy in the endless listing, kept out of the tab order (screen readers skip the whole copy).
interface Props { product: CollectionEntry<"products">; eager?: boolean; priority?: boolean; clone?: boolean }
const { product, eager = false, priority = false, clone = false } = Astro.props
const { title, price, photos, status } = product.data
const [cover] = photos
---
<a class="card" href={`/produits/${product.id}/`} tabindex={clone ? -1 : undefined}>
  {cover && <Image src={cover} alt="" widths={[360, 540, 720, 1080]} sizes="(min-width: 900px) 20vw, 86vw" loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} />}
  <span class="label">
    <span class="tag">{title}</span>
    <span class="tag tag--dark">{status === "available" ? formatPrice(price) : `[ ${statusLabel[status]} ]`}</span>
  </span>
</a>

<style>
  .card { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; text-decoration: none; }
  .card :global(img) { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55); transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .label { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.375rem 0.5rem; text-align: center; }
  @media (hover: hover) { .card:hover :global(img) { transform: translateY(-6px) scale(1.02); } }
  .card:active :global(img) { transform: scale(0.98); }
</style>
