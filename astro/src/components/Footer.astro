---
import { getNavLinks } from "../nav"
const { links } = await getNavLinks()
const year = new Date().getFullYear()
// Same fade as <main> (see Base.astro).
const ease = "cubic-bezier(0.23, 1, 0.32, 1)"
const fade = {
  old: { name: "page-out", duration: "0.35s", easing: ease, fillMode: "both" },
  new: { name: "page-in", duration: "0.35s", delay: "0.35s", easing: ease, fillMode: "both" },
}
const pageFade = { forwards: fade, backwards: fade }
---
<footer class="foot mono" transition:name="foot" transition:animate={pageFade}>
  <div class="bar glass">
  <p>© {year} chichi</p>
  <ul>
    {links.map((l) => <li><a href={l.href}>[ {l.label} ]</a></li>)}
  </ul>
  </div>
</footer>

<style>
  .foot { padding: clamp(3rem, 8vw, 6rem) max(var(--gutter), env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left)); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 1.5rem; padding: 0 1rem; border-radius: 10px; color: var(--text-dim); }
  ul { display: flex; gap: 0 1rem; list-style: none; padding: 0; }
  a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  @media (hover: hover) { a:hover { color: var(--text); } }
</style>
