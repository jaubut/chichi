---
import Mark from "./Mark.astro"
import { getArtist, getNavLinks } from "../nav"
const path = Astro.url.pathname
const [{ links, count }, artist] = await Promise.all([getNavLinks(), getArtist()])
---
<header class="top">
  <nav class="bar" aria-label="Principal">
    <div class="group">
      <a href="/" class="brand glass" aria-label="chichi, accueil"><Mark size={22} /><span>chichi</span></a>
      {count > 0 && <a href="/#collection" class="count glass mono" aria-label={`${count} ${count === 1 ? "pièce" : "pièces"}`}>{count}</a>}
      <ul class="links glass">
        {links.map((l) => <li><a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
    </div>
    <p class="meta mono glass">[ Céramique{artist && ` · ${artist.data.name}`} ]</p>
  </nav>
</header>

<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 10; padding: calc(env(safe-area-inset-top) + clamp(0.75rem, 2vw, 1.75rem)) max(var(--gutter), env(safe-area-inset-right)) 0 max(var(--gutter), env(safe-area-inset-left)); pointer-events: none; }
  .bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .group { display: flex; align-items: center; gap: 0.375rem; pointer-events: auto; }
  .brand { display: inline-flex; align-items: center; gap: 0.625rem; min-height: 44px; padding: 0 1.125rem 0 0.75rem; border-radius: 999px; font-weight: 700; font-size: 1rem; letter-spacing: 0.32em; text-transform: uppercase; text-decoration: none; }
  .count { display: inline-grid; place-items: center; min-width: 44px; height: 44px; border-radius: 999px; text-decoration: none; }
  .links { display: flex; list-style: none; padding: 0 0.375rem; border-radius: 999px; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.75rem; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; text-decoration: none; color: var(--text-dim); }
  .links a[aria-current="page"] { color: var(--text); }
  @media (hover: hover) { .links a:hover { color: var(--text); } }
  .meta { pointer-events: auto; display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px; }
  /* Phone: brand pill · count · Infos; the boutique link duplicates the count pill so it hides. */
  @media (max-width: 640px) {
    .meta { display: none; }
    .links li:first-child { display: none; }
    .group { width: 100%; }
    .brand { flex: 1; justify-content: center; }
  }
</style>
