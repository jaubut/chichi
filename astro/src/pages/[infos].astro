---
import { Image } from "astro:assets"
import { render, type CollectionEntry } from "astro:content"
import Base from "../layouts/Base.astro"
import { getArtist } from "../nav"

// /infos/ is built only once src/content/artist/ has an entry.
export async function getStaticPaths() {
  const artist = await getArtist()
  return artist ? [{ params: { infos: "infos" }, props: { artist } }] : []
}

interface Props { artist: CollectionEntry<"artist"> }
const { artist } = Astro.props
const { name, tagline, location, portrait, portraitAlt, instagram, email } = artist.data
const { Content } = await render(artist)
---
<Base title="Infos" description={tagline ?? `${name}, céramiste — chichi`}>
  <article class="wrap about">
    {portrait && (
      <div class="portrait"><Image src={portrait} alt={portraitAlt ?? name} widths={[600, 900]} sizes="(min-width: 900px) 34vw, 86vw" loading="eager" fetchpriority="high" /></div>
    )}
    <div class="info glass">
      <p class="mono dim">[ L’atelier{location && ` · ${location}`} ]</p>
      <h1>{name}</h1>
      {tagline && <p class="lede">{tagline}</p>}
      <div class="body"><Content /></div>
      {(instagram || email) && (
        <ul class="contact">
          {instagram && <li><a class="btn btn--glass" href={instagram} rel="noopener">Instagram</a></li>}
          {email && <li><a class="btn" href={`mailto:${email}`}>Écrire</a></li>}
        </ul>
      )}
    </div>
  </article>
</Base>

<style>
  .about { display: grid; gap: 1.5rem; align-items: end; min-height: 100svh; padding-top: calc(var(--header-h) + env(safe-area-inset-top)); padding-bottom: var(--gutter); }
  @media (min-width: 900px) { .about { grid-template-columns: minmax(0, 1fr) 26rem; } .about:not(:has(.portrait)) .info { grid-column: 2; } }
  .portrait { justify-self: center; width: min(34vw, 30rem); }
  @media (max-width: 899px) { .portrait { width: min(86vw, 26rem); } }
  .portrait :global(img) { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6); }
  .info { display: flex; flex-direction: column; gap: 0.875rem; padding: 1.25rem; border-radius: 10px; }
  .dim { color: var(--text-dim); }
  h1 { font-size: clamp(1.75rem, 5vw, 2.5rem); }
  .lede { font-weight: 600; text-transform: uppercase; font-size: 0.875rem; }
  .body { color: var(--text-dim); font-size: 0.9375rem; padding-top: 0.875rem; border-top: 1px solid var(--glass-line); }
  .body :global(h2) { font-size: 1rem; margin: 1.5rem 0 0.5rem; color: var(--text); }
  .body :global(p) { margin: 0.5rem 0; overflow-wrap: anywhere; }
  .body :global(a) { color: var(--text); overflow-wrap: anywhere; }
  .body :global(ul), .body :global(ol) { padding-left: 1.25rem; margin: 0.5rem 0; }
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; list-style: none; padding: 0; margin-top: 0.5rem; }
  .contact :global(.btn) { width: 100%; justify-content: center; }
</style>
