---
import { Image } from "astro:assets"
import { render, type CollectionEntry } from "astro:content"
import Base from "../layouts/Base.astro"
import { getArtist } from "../nav"

// /infos/ is built only once src/content/artist/ has an entry.
export async function getStaticPaths() {
  const artist = await getArtist()
  return artist ? [{ params: { infos: "infos" }, props: { artist } }] : []
}

interface Props { artist: CollectionEntry<"artist"> }
const { artist } = Astro.props
const { name, tagline, location, portrait, portraitAlt, instagram, email } = artist.data
const { Content } = await render(artist)
---
<Base title="Infos" description={tagline ?? `${name}, céramiste — chichi`}>
  <article class="wrap about">
    {portrait && (
      <div class="portrait"><Image src={portrait} alt={portraitAlt ?? name} widths={[600, 900]} sizes="(min-width: 900px) 40vw, 100vw" loading="eager" fetchpriority="high" /></div>
    )}
    <div class="text">
      <p class="eyebrow">L’atelier{location && ` · ${location}`}</p>
      <h1>{name}</h1>
      {tagline && <p class="lede">{tagline}</p>}
      <div class="body"><Content /></div>
      {(instagram || email) && (
        <ul class="contact">
          {instagram && <li><a class="btn btn--ghost" href={instagram} rel="noopener">Instagram</a></li>}
          {email && <li><a class="btn" href={`mailto:${email}`}>Écrire</a></li>}
        </ul>
      )}
    </div>
  </article>
</Base>

<style>
  .about { display: grid; gap: clamp(1.5rem, 5vw, 4rem); padding-top: clamp(2.5rem, 8vw, 6rem); align-items: start; }
  @media (min-width: 900px) { .about:has(.portrait) { grid-template-columns: 0.9fr 1.1fr; } }
  .portrait { aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; background: var(--gray-50); }
  @media (max-width: 899px) { .portrait { aspect-ratio: 4 / 3; max-height: 55svh; } }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .text { max-width: 40rem; }
  h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 0.75rem 0 1.25rem; }
  .lede { font-size: 1.125rem; color: var(--gray-500); padding-bottom: 2rem; border-bottom: 1px solid var(--gray-200); margin-bottom: 2rem; }
  .body :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 0.75rem; }
  .body :global(p) { margin: 0.75rem 0; overflow-wrap: anywhere; }
  .body :global(a) { color: var(--blue); overflow-wrap: anywhere; }
  .body :global(ul), .body :global(ol) { padding-left: 1.25rem; margin: 0.75rem 0; }
  .body :global(blockquote) { font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); padding: 0; margin: 1.5rem 0; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.75rem; list-style: none; padding: 0; margin-top: 2rem; }
</style>
