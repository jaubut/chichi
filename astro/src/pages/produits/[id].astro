---
import { getCollection, render, type CollectionEntry } from "astro:content"
import Base from "../../layouts/Base.astro"

export async function getStaticPaths() {
  const products = await getCollection("products")
  return products.map((product) => ({ params: { id: product.id }, props: { product } }))
}

interface Props { product: CollectionEntry<"products"> }
const { product } = Astro.props
const { title, price, cta, image, imageAlt, buyUrl, accent } = product.data
const { Content } = await render(product)
---
<Base title={title} description={`${title} — ${price} $`}>
  <article class="wrap product" style={`--accent: var(--${accent})`}>
    <div class="photo">
      <img src={image} alt={imageAlt || title} width="1200" height="1500" fetchpriority="high" decoding="async" />
    </div>
    <div class="text">
      <a href="/#collection" class="eyebrow back">← Boutique</a>
      <h1>{title}</h1>
      <p class="price">{price} $</p>
      <div class="body"><Content /></div>
      {buyUrl
        ? <a class="btn buy" href={buyUrl}>{cta} {price} $</a>
        : <>
            <button type="button" class="btn buy" disabled aria-describedby="buy-soon">{cta} {price} $</button>
            <p class="soon" id="buy-soon">Achat en ligne bientôt disponible.</p>
          </>}
    </div>
  </article>
</Base>

<style>
  .product { display: grid; gap: clamp(1.5rem, 5vw, 4rem); padding-top: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 900px) { .product { grid-template-columns: 1.1fr 1fr; } }
  .photo { aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; background: var(--accent);
    box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--accent) 70%, transparent); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 899px) { .photo { aspect-ratio: 1; } }
  .text { display: flex; flex-direction: column; gap: 1rem; max-width: 34rem; }
  .back { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  @media (hover: hover) { .back:hover { color: var(--ink); } }
  .soon { font-size: 0.875rem; color: var(--gray-500); }
  h1 { font-size: clamp(3rem, 9vw, 5.5rem); }
  .price { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; }
  .body { color: var(--gray-500); }
  .buy { align-self: flex-start; min-height: 56px; padding-inline: 2rem; font-size: 1.125rem; margin-top: 0.5rem; }
  @media (max-width: 640px) { .buy { align-self: stretch; } }
</style>
