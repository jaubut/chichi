---
import { Image } from "astro:assets"
import { render, type CollectionEntry } from "astro:content"
import Base from "../../layouts/Base.astro"
import { formatPrice, getProducts, statusLabel } from "../../nav"

export async function getStaticPaths() {
  const products = await getProducts()
  return products.map((product) => ({ params: { id: product.id }, props: { product } }))
}

interface Props { product: CollectionEntry<"products"> }
const { product } = Astro.props
const { title, price, photos, photoAlt, status, clay, glaze, dimensions, care, buyUrl, accent } = product.data
const { Content } = await render(product)
const details = [
  ["Argile", clay],
  ["Émail", glaze],
  ["Dimensions", dimensions],
  ["Entretien", care],
].filter((d): d is [string, string] => Boolean(d[1]))
---
<Base title={title} description={`${title}, céramique — ${formatPrice(price)}`} accent={accent}>
  <article class="pdp">
    <div class="stage">
      <ul class="photos" data-lenis-prevent-horizontal aria-label={`Photos, ${photos.length}`} tabindex={photos.length > 1 ? 0 : undefined}>
        {photos.map((p, i) => (
          <li id={`photo-${i + 1}`}><Image src={p} alt={i === 0 ? photoAlt : `${photoAlt} (${i + 1})`} widths={[600, 900, 1200]} sizes="(min-width: 900px) 40vw, 86vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} /></li>
        ))}
      </ul>
      {photos.length > 1 && (
        <ol class="thumbs glass" aria-label="Aller à la photo">
          {photos.map((p, i) => <li><a href={`#photo-${i + 1}`} aria-label={`Photo ${i + 1}`}><Image src={p} alt="" widths={[120]} sizes="48px" /></a></li>)}
        </ol>
      )}
    </div>
    <aside class="panel">
      <div class="info glass">
        <a href="/#collection" class="back mono"><span aria-hidden="true">←</span> [ Boutique ]</a>
        <h1>{title}</h1>
        <div class="body"><Content /></div>
        <dl class="rows mono">
          <div><dt>Statut</dt><dd>[ {statusLabel[status]} ]</dd></div>
          {details.map(([k, v]) => <div><dt>{k}</dt><dd>[ {v} ]</dd></div>)}
        </dl>
        {status === "available" && !buyUrl && <p class="note mono" id="buy-note">Achat en ligne bientôt disponible</p>}
        {status !== "available" && <p class="note mono">{status === "sold" ? "Pièce unique, déjà vendue" : "Pièce réservée"}</p>}
      </div>
      {status === "available" && (buyUrl
        ? <a class="btn buy buy--live" href={buyUrl}><span>Acheter</span><span>{formatPrice(price)}</span></a>
        : <button type="button" class="btn buy" aria-disabled="true" aria-describedby="buy-note"><span>Acheter</span><span>{formatPrice(price)}</span></button>)}
    </aside>
  </article>
</Base>

<style>
  .pdp { position: relative; }
  .stage { position: relative; display: grid; place-items: center; min-height: 100svh; padding: calc(var(--header-h) + env(safe-area-inset-top)) var(--gutter) 2rem; }
  .photos { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; width: min(40vw, 34rem); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; list-style: none; padding: 0; }
  .photos li { display: grid; place-items: center; scroll-snap-align: center; }
  .photos :global(img) { width: 100%; max-height: 72svh; object-fit: contain; border-radius: 6px; box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6); }
  .thumbs { position: absolute; left: var(--gutter); bottom: var(--gutter); display: flex; gap: 0.25rem; padding: 0.25rem; border-radius: 10px; list-style: none; }
  .thumbs a { display: block; width: 44px; height: 44px; border-radius: 6px; overflow: hidden; }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .panel { display: flex; flex-direction: column; gap: 0.5rem; }
  @media (min-width: 900px) { .panel { position: absolute; right: var(--gutter); bottom: var(--gutter); width: 23.5rem; } }
  .info { display: flex; flex-direction: column; gap: 0.875rem; padding: 1rem 1rem 1.125rem; border-radius: 10px; }
  .back { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; margin: -0.625rem 0 -0.5rem; align-self: flex-start; text-decoration: none; color: var(--text-dim); }
  @media (hover: hover) { .back:hover { color: var(--text); } }
  h1 { font-size: 1.5rem; }
  .body { color: var(--text-dim); font-size: 0.875rem; }
  .body :global(p + p) { margin-top: 0.5rem; }
  .rows { display: grid; gap: 0.375rem; padding-top: 0.875rem; border-top: 1px solid var(--glass-line); }
  .rows div { display: flex; gap: 0.75rem; }
  dt { min-width: 7.5rem; }
  .note { color: var(--text-dim); font-size: 0.75rem; }
  .buy { width: 100%; min-height: 52px; }

  @media (max-width: 899px) {
    .stage { min-height: 74svh; padding-bottom: 1rem; }
    .photos { width: min(86vw, 30rem); }
    .photos :global(img) { max-height: 62svh; }
    .thumbs { display: none; }
    .panel { padding: 0 var(--gutter); }
    /* Several photos: the next one peeks in so the swipe is obvious. */
    .photos:has(> li + li) { grid-auto-columns: 88%; gap: 0.75rem; }
    /* Only a live checkout link sticks to the bottom; leave room so it never hides the panel. */
    .panel:has(.buy--live) { padding-bottom: 4.5rem; }
    .buy--live { position: sticky; bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 5; box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); }
  }
</style>
